---
import { getCollection } from 'astro:content';
import Base from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';

const recepty = await getCollection('recepty');
---

<Base>
  <section class="hero">
    <h1>Domácí <em>recepty</em>, které fungují</h1>
    <p>Jednoduché věci, které vařím pořád dokola.</p>
  </section>

  <div class="filtr" role="group" aria-label="Filtr receptů">
    <button class="btn active" data-filter="vse">Vše</button>
    <button class="btn" data-filter="hlavni">Hlavní</button>
    <button class="btn" data-filter="polevky">Polévky</button>
    <button class="btn" data-filter="sladke">Sladké</button>
  </div>

  <div class="grid">
    {recepty.map((r) => (
      <div data-kategorie={r.data.kategorie}>
        <RecipeCard
          title={r.data.title}
          cas={r.data.cas}
          porce={r.data.porce}
          href={`/recepty/${r.id}`}
        />
      </div>
    ))}
  </div>
</Base>

<style>
  .hero { padding: 60px 0 40px; }
  h1 { font-size: clamp(42px, 9vw, 72px); }
  em { color: var(--red); }
  .hero p { margin: 14px 0 0; color: var(--muted); }

  .filtr {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 7px 18px;
    border: 1.5px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 600 14px var(--font-body);
    cursor: pointer;
    border-radius: 999px;
    transition: border-color .15s, background .15s, color .15s;
  }
  .btn:hover { border-color: var(--red); color: var(--red); }
  .btn.active {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 18px;
  }
  .grid > [data-kategorie] { display: contents; }
  .grid > [data-kategorie].hidden { display: none; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filtr .btn');
  const cards = document.querySelectorAll<HTMLElement>('.grid > [data-kategorie]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      cards.forEach((card) => {
        const match = filter === 'vse' || card.dataset.kategorie === filter;
        card.classList.toggle('hidden', !match);
      });
    });
  });
</script>
