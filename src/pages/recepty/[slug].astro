---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const recepty = await getCollection('recepty');
  return recepty.map((r) => ({ params: { slug: r.id }, props: { recept: r } }));
}

const { recept } = Astro.props;
const { Content } = await render(recept);
---

<Base title={recept.data.title}>
  <div class="meta">
    <span class="cas">⏱ {recept.data.cas} min</span>
    <span class="porce">{recept.data.porce} porce</span>
  </div>

  <h1>{recept.data.title}</h1>

  <div class="layout">
    <aside class="ingredience">
      <h2>Ingredience</h2>
      <ul>
        {recept.data.ingredience.map((i) => <li>{i}</li>)}
      </ul>
    </aside>

    <section class="postup">
      <h2>Postup</h2>
      <Content />
    </section>
  </div>
</Base>

<style>
  .meta {
    display: flex;
    gap: 20px;
    margin: 36px 0 10px;
    font-size: 15px;
    color: var(--muted);
  }
  .cas { font-weight: 600; color: var(--red); }

  h1 { font-size: clamp(32px, 6vw, 52px); margin-bottom: 48px; }

  .layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 60px;
    align-items: start;
  }

  .ingredience h2,
  .postup h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .ingredience ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ingredience li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.4;
  }
  .ingredience li:first-child { border-top: 1px solid var(--line); }

  .postup :global(p) {
    margin: 0 0 22px;
    line-height: 1.7;
    counter-increment: krok;
    padding-left: 36px;
    position: relative;
  }
  .postup :global(p)::before {
    content: counter(krok);
    position: absolute;
    left: 0;
    top: 2px;
    font: 600 12px var(--font-body);
    color: var(--red);
    background: var(--pink);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .postup { counter-reset: krok; }

  @media (max-width: 640px) {
    .layout { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
